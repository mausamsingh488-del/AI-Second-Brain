# Flask Environment Settings
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=ai-second-brain-super-secret-key-change-in-production

# Server Port
PORT=5000

# Global Demo Mode (true enables full simulation without external hardware)
DEMO_MODE=true

# SQLite Database
DATABASE_URL=sqlite:///database/second_brain.db

# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Whisper STT Mode (base / tiny / small / medium)
WHISPER_MODEL=base

# ESP32 Hardware Node
ESP32_IP=192.168.1.150
ESP32_PORT=80

# GitHub Integration
GITHUB_USERNAME=mausam-dev
GITHUB_TOKEN=
